# ---------------------------------------------------------------------------
# Flora Hospitality | Sales Enquiry Platform - environment template
# Copy to .env.local (development) or configure in Vercel > Project > Settings
# > Environment Variables (production). NEVER commit real values.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Public URL of the deployment (used in notification e-mails and links)
APP_URL=http://localhost:3000
# 32+ random characters. Used to sign session cookies and cron tokens.
#   openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string
# Display timezone for all dates (storage is always UTC)
APP_TIMEZONE=Asia/Dubai

# --- Database (source of truth) --------------------------------------------
# Development: local SQLite file
DATABASE_URL=file:./data/flora.db
# Production (Turso / libSQL - durable, Vercel-compatible):
#   DATABASE_URL=libsql://flora-sales-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<turso auth token>
DATABASE_AUTH_TOKEN=

# --- Central reporting sync -------------------------------------------------
# Every enquiry / activity / rate revision write is mirrored to the selected
# provider through the server-side outbox. Options: none | google-sheets | microsoft-lists
SYNC_PROVIDER=none

# Option A - Google Workspace (service account with Sheets API enabled, sheet
# shared with the service-account e-mail as Editor; sheet must NOT be public)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service-account JSON (keep the \n escapes)
GOOGLE_PRIVATE_KEY=
# Master sheet "Flora Sales Enquiries (Master)" owned by floraabhijith@gmail.com (created 2026-10-13)
GOOGLE_SHEETS_SPREADSHEET_ID=1fOm5pl4ZinOH6F2TiUIVyLC0yqhkpuw3D_fA8pb5N-I

# Option B - Microsoft 365 (Entra ID app registration, application permission
# Sites.Selected or Sites.ReadWrite.All granted to the private SharePoint site)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SITE_ID=
MS_LIST_ID_ENQUIRIES=
MS_LIST_ID_ACTIVITIES=
MS_LIST_ID_RATES=

# --- E-mail notifications (SMTP via Google Workspace or Microsoft 365) -----
# Options: console (log only) | smtp
EMAIL_PROVIDER=console
EMAIL_FROM="Flora Sales Platform <sales-platform@florahospitality.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Scheduled jobs -----------------------------------------------------------
# Vercel sends this automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me-too

# --- Bootstrap administrator (used by `npm run db:seed` on first run) -------
ADMIN_EMAIL=admin@florahospitality.com
ADMIN_NAME="Commercial Head"
ADMIN_PASSWORD=ChangeMe!2026
